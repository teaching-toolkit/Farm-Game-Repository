{
  "format": "learnkit-math-1",
  "note": "Mental maths from 1st to about 7th class, in categories (plus & minus, times & divide, numbers, fractions, decimals & percent, measures, powers & negatives). Every category has two sections: 'By heart' (facts to recall at once — like 8 + 5 or 6 × 7) and 'Working it out' (too many to learn by heart: the steps should run smoothly, like 32 - 17 or 12 × 17). Each level is a set of tasks made by a generator ('kind' + its settings, see learnkit/math_engine.gd). 'quick' = seconds for a quick answer (plus timing.digitAllowance for every typed character after the first); 'need' = how many different tasks must be learned to pass; 'class' = the school year it usually belongs to (Swiss Lehrplan 21 / Schweizer Zahlenbuch; US Common Core is close); 'after' = a level that must be passed first; 'keys' = extra keys on the number pad (. − R). Order within a section = the order of learning.",
  "sources": [
    "Lehrplan 21 Mathematik, Zyklus 1–2 (core facts ×1 ×2 ×5 ×10 in 1st–2nd class; the whole Einmaleins automated in 3rd; mental arithmetic to 4 digits in 4th; decimals and fractions in 5th–6th) — Schweizer Zahlenbuch handreichung",
    "PIKAS (DZLM): understand first, then core tasks by heart, then derive the rest, then automate",
    "Common Core: sums of two one-digit numbers from memory by end of grade 2; all products of two one-digit numbers from memory by end of grade 3",
    "XtraMath: 3 s per fact as the fluency mark (6 s default, 12 s for young learners)",
    "Times Tables Rock Stars: speed titles by seconds per answer"
  ],
  "timing": {"digitAllowance": 0.5, "note": "A quick answer: the level's 'quick' seconds plus digitAllowance for every character typed after the first (typing 13 takes longer than typing 7). Games can stretch all times (scale), e.g. for a younger child."},
  "srs": {
    "gaps": [3, 8, 20, 60, 180, 500, 1400],
    "knownBox": 4,
    "wrongAfter": 2,
    "slowAfter": 3,
    "newInFlight": 4,
    "newInFlightStruggling": 2,
    "fastTrack": 4,
    "fastTrackWithin": 12,
    "reviewRun": 1,
    "firstSightBox": 3,
    "reviewRunStruggling": 4,
    "struggleWindow": 8,
    "struggleWrong": 4,
    "struggleSlow": 7,
    "boosterEvery": 3,
    "passAccuracy": 0.8,
    "goldReviewShare": 0.3,
    "note": "Spaced repetition like Anki, counted in answers: a wrong task comes back after wrongAfter others, a slow one after slowAfter; quick and right it waits gaps[box] answers (box goes up by one each time). At most newInFlight new tasks are being learned at once. A level passes when 'need' of its tasks reached box 2 and passAccuracy of the recent answers on it were right — or at once when fastTrack answers in a row on it are quick and right while it is still new (within its first fastTrackWithin answers). firstSightBox: a task answered quick and right the very first time starts in this box (the child knows it already). reviewRun: after this many reviews in a row a new task comes (if there is room), so the child keeps moving on (reviewRunStruggling when it is hard going). Hard going (struggleWrong wrong or struggleSlow slow among the last struggleWindow): every boosterEvery-th task is an easy known one. goldReviewShare: how often a level waiting for its gold check is reviewed."
  },
  "medals": {
    "bronze": {"emoji": "🥉", "name": "Bronze", "means": "Level passed: enough of its tasks were quick and right twice in a row."},
    "silver": {"emoji": "🥈", "name": "Silver", "means": "By heart: every task of a small level (up to allUpTo tasks), or share of the tasks of a bigger one, quick and right twice in a row, and 9 of the last 10 answers on the level quick and right. Working it out: silverCount different tasks quick and right, and 9 of the last 10 quick and right.", "silverCount": 20, "allUpTo": 20, "share": 0.7},
    "gold": {"emoji": "🥇", "name": "Gold", "days": 7, "means": "Still quick at least 'days' days after silver: it has stuck."},
    "trophy": {"emoji": "🏆", "name": "Trophy", "means": "Every level of a section has silver."},
    "crown": {"emoji": "👑", "name": "Crown", "means": "Every level of a section has gold."}
  },
