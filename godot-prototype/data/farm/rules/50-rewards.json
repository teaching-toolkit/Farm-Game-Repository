  "postcards": {
    "chanceBase": 0.35,
    "chancePerFriend": 0.2,
    "firstSure": true,
    "choicesMax": 3,
    "note": "Friends are the people you helped (finished side quests; the same person counts once). At a milestone (a pet arrives, the library grows, every 12 goals) a friend may hear of it and send a postcard with a gift: chance = chanceBase + chancePerFriend x friends (at most 100%; the very first postcard always comes). The gift is picked from as many cards as there are friends (1, 2, 3 at most). Cards not picked can come again on a later postcard.",
    "news": {
      "pet": "your new {pet}",
      "library": "your library growing",
      "goals": "all your work on the farm ({n} jobs done!)"
    },
    "messages": [
      "Dear {player}, I heard about {news}! Here is a little something for your farm.",
      "Hello {player}! Word travels fast in our village — {news}! I wanted to send you a present.",
      "{player}, everyone is talking about {news}. Thank you again for your help — this is for you!",
      "Dear {player}, I was so happy to hear about {news}. I hope this helps on the farm!"
    ]
  }
}