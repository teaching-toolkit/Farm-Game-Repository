  "perks": {
    "note": "Small extras that make the farm prettier or livelier. They do not change the economy. Some come from favours (side quest 'perk'), others from achievements ('when': rest_quick>=N quick Rest answers, medals>=N Rest sum medals won, sold_kinds>=N different things sold, harvests>=N, seasons>=N, cards>=N, sidequests>=N, unlocked:id). Every perk can be switched off in the album.",
    "list": [
      {
        "id": "perk_butterflies",
        "name": "Butterflies",
        "emoji": "🦋",
        "desc": "Butterflies flutter over your fields. A thank-you from Granny Maud's meadow."
      },
      {
        "id": "perk_sparkles",
        "name": "Magic sparkles",
        "emoji": "✨",
        "desc": "Sparkles where you tap the farm. A trick the twins taught you."
      },
      {
        "id": "perk_sounds",
        "name": "Farm sounds",
        "emoji": "🔔",
        "desc": "Animal voices: hens, cows and sheep call when you tap their pen, and now and then on their own; birds sing over the fields. Ella's little bell started it."
      },
      {
        "id": "perk_rainbow",
        "name": "Rainbows",
        "emoji": "🌈",
        "desc": "A rainbow over the farm after the rain. Hilde says the washing dries best under one."
      },
      {
        "id": "perk_lightning",
        "name": "Lightning sums",
        "emoji": "⚡",
        "desc": "Quick Rest sums sometimes crackle with lightning.",
        "when": "rest_quick>=25"
      },
      {
        "id": "perk_streak",
